<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Parakeet Café · Week Types for Payroll, Next 52 Weeks</title>
<style>
{% include "deck_style.css" %}
/* this deck */
.tbadge{display:inline-block;font-family:var(--sans);font-weight:700;font-size:9px;letter-spacing:1.3px;text-transform:uppercase;padding:4px 9px 3px;line-height:1.2;white-space:nowrap}
.tbadge.hol{background:#000;color:#fff}
table.heat{border-collapse:separate;border-spacing:2px;table-layout:fixed;width:100%;font-family:var(--sans)}
table.heat th{font-size:9.5px;letter-spacing:.6px;text-transform:none;text-align:center;border:none;padding:0 0 3px;color:var(--g700);font-weight:700;line-height:1.25}
table.heat th small{display:block;font-size:8px;font-weight:600;color:var(--pink);letter-spacing:.2px}
table.heat th.sp{color:#000}
table.heat th.hr{width:.48in;text-align:right;padding-right:6px;font-size:10px;vertical-align:middle}
table.heat td{border:none;text-align:center;padding:2px 2px 1px;line-height:1.1;white-space:nowrap}
table.heat td b{display:block;font-size:12.5px;font-weight:600;letter-spacing:-.1px}
table.heat td span{display:block;font-size:8.5px;opacity:.78}
table.heat td.tot{background:var(--g50);color:#000}
table.heat th.tot{width:.95in}
table.heat tr.day td{background:var(--g50);color:#000;border-top:1.5px solid #000}
table.heat tr.day th{border-top:1.5px solid #000;padding-top:3px}
.side{font-family:var(--sans)}
.side .blk{border-top:1px solid var(--ink);padding:7px 0 9px}
.side .blk:first-child{border-top:2px solid var(--ink)}
.side .lab{font-size:9.5px;letter-spacing:.3px;color:var(--g700)}
.side .val{font-weight:600;font-size:25px;line-height:1.1;margin-top:3px;letter-spacing:-.3px}
.side .val.mid{font-size:17px}
.side .cap{font-size:10px;color:var(--g700);margin-top:2px;line-height:1.35}
.side ul{list-style:none;margin:4px 0 0;padding:0}
.side li{font-size:10.5px;line-height:1.35;padding:2px 0}
.side li b{font-weight:600}
.side li small{color:var(--g500);font-size:9.5px}
.tag-row{display:flex;align-items:center;gap:12px;margin-top:12px}
.tag-row .name{font-family:var(--sans);font-weight:700;font-size:12px;letter-spacing:2px;text-transform:uppercase}
.tag-row + h1{margin-top:6px;font-size:24px}
table.cal{border-collapse:separate;border-spacing:1.5px;width:100%;table-layout:fixed;font-family:var(--sans)}
table.cal th{border:none;padding:0 8px 0 0;font-size:11px;letter-spacing:0;text-transform:none;color:#000;font-weight:600;width:1.35in;text-align:right}
table.cal td{border:none;padding:0;height:34px;position:relative}
table.cal td.own::after{content:"";position:absolute;left:50%;top:50%;width:6px;height:6px;margin:-3px 0 0 -3px;border-radius:50%;background:#000}
table.cal td.own.dk::after{background:#fff}
table.cal tr.m td{height:auto;font-size:10px;color:var(--g700);font-weight:600;text-align:left;overflow:visible;white-space:nowrap}
table.cal tr.w td{height:auto;font-size:8px;color:var(--g500);text-align:left}
table.cal td.n{width:.55in;text-align:center;font-weight:700;font-size:13px;background:none}
.legend{display:flex;gap:16px;font-family:var(--sans);font-size:11px;align-items:center;flex-wrap:wrap}
.legend i{display:inline-block;width:13px;height:13px;margin-right:6px;vertical-align:-2px}
.legend i.dot{width:7px;height:7px;border-radius:50%;background:#000;margin:0 6px 0 3px;vertical-align:1px}
svg.wk .ax{font-family:var(--sans);font-size:10px;fill:var(--g700)}
svg.wk .tl{font-family:var(--sans);font-size:10.5px;font-weight:700;fill:#000}
table.types td{padding:6px 8px}
table.types.tight td{padding:3.5px 8px}
table.types td .tbadge{font-size:8.5px}
.types-note{font-family:var(--sans);font-size:10.5px;color:var(--g700);margin-top:8px;line-height:1.45}
table.sum td{padding:5px 10px 5px 0;font-size:9.5px;white-space:normal;line-height:1.35;vertical-align:top}
.hol-t{font-family:var(--sans);font-size:10px;color:var(--g700);margin:8px 0 4px}
.hol-t b{color:#000;font-size:11px}
.hols{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px}
.hc{background:var(--g50);padding:3px 7px 4px;font-family:var(--sans);min-width:0;overflow:hidden;line-height:1.25}
.hc .hn{font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hc .hd{font-size:9px;color:var(--g700);white-space:nowrap}
.hc .hv{white-space:nowrap}
.hc .hv span{font-weight:700;font-size:13px}
.hc .hv span.up{color:var(--pink)}
.hc .hv small{font-size:8.5px;color:var(--g500)}
svg.spread .ax{font-family:var(--sans);font-size:9px;fill:var(--g700)}
svg.spread .tl{font-family:var(--sans);font-size:9.5px;font-weight:700;fill:#000}
table.sum th{text-align:left;padding-left:0}
table.idx td{padding:2.6px 7px;font-size:10.5px}
table.idx .tbadge{font-size:7.5px;padding:2px 6px 1px}
table.sum td.nw{white-space:nowrap}
table.sum .tbadge{font-size:8px;padding:3px 7px 2px}
</style>
</head>
<body>
{% macro head(eyebrow) %}<div class="head"><img src="assets/logo-bird.png" alt="Parakeet Café"><span class="eyebrow">{{ eyebrow }}</span></div>{% endmacro %}
{% macro foot(note) %}<div class="foot"><span>Parakeet Café · Week Types for Payroll, next 52 weeks</span><span>{{ note }}</span><span class="pn"></span></div>{% endmacro %}
{% macro badge(t) %}<span class="tbadge" style="background:{{ n.COLOR[t] }};color:{{ n.INK_ON[t] }}">{{ t }}</span>{% endmacro %}
{% set SRC = "Today's run-rate (no growth) · hours from Toast checks, Oct 2024 – Oct 14, 2026" %}
{% set TYPES = ["Low", "Normal", "High", "Super high", "Remodeled"] %}

{# ================================================================== COVER #}
<section class="page cover">
  <div class="cover-left">
    <img class="logo" src="assets/logo-bird.png" alt="Parakeet Café">
    <div class="eyebrow">Payroll · the next 52 weeks</div>
    <div class="cover-title">Week Types<br>and Hourly<br>Templates</div>
    <p class="cover-sub">Each café's next 52 weeks grouped into a few types of week, and for each type the average week by day and hour, in sales and checks: the template to build the schedule on.</p>
    <div class="cover-meta">
      Ten cafés of the run-rate budget · 52 weeks, {{ n.w1.strftime("%b %-d, %Y") }} to {{ n.w52.strftime("%b %-d, %Y") }}<br>
      Sales: today's run-rate by day · hours and checks: Toast POS, {{ n.hours_from.strftime("%b %Y") }} – {{ n.last_day.strftime("%b %-d, %Y") }}, checked on {{ n.live.first.strftime("%b %-d") }}–{{ n.live.last.strftime("%-d, %Y") }}<br>
      Prepared October 21, 2026 · workbook: Parakeet_Week_Templates_Next_52_Weeks.xlsx
    </div>
  </div>
  <div class="cover-right"><img src="assets/hero-1.jpg" alt=""></div>
</section>

{# ================================================================== SUMMARY #}
{% set ch = n.coronado_high %}{% set cl = n.coronado_low %}
<section class="page">
  {{ head("The short version") }}
  <h1>Two to four types of week per café, each with its own week by day and hour</h1>
  <div class="row" style="margin-top:10px">
    <div class="col flist" style="flex:1.35">
      <div class="finding"><div class="num">01</div><p><b>Two to four types per café</b>, each {{ "%.0f" | format(n.step * 100) }}% above the one below, in runs of {{ n.min_run }} weeks or more. Four: {{ n.n_by_k[4] | and_join }}. Three: {{ n.n_by_k[3] | and_join }}. Two (the minimum): {{ n.n_by_k[2] | and_join }}.</p></div>
      <div class="finding"><div class="num">02</div><p><b>The busiest weeks are summer at the beach.</b> Coronado's High weeks ({{ ch.ranges[0].dates }}) sell {{ ch.avg | fk }} a week, {{ (ch.avg / cl.avg - 1) | pct }} on its Low weeks. Brentwood and Beverly Hills sell least in summer.</p></div>
      {% set lj = n.later[0] %}<div class="finding"><div class="num">03</div><p><b>Hours move with the season.</b> In summer {{ n.later | map(attribute="name") | list | and_join }} sell more of the day after 2pm ({{ lj.name }}: {{ "%.1f" | format(lj.hi * 100) }}% of a {{ lj.hi_t }} week, {{ "%.1f" | format(lj.lo * 100) }}% of a {{ lj.lo_t }} one); each type has its own split of the day.</p></div>
      <div class="finding"><div class="num">04</div><p><b>Holiday weeks go to the appendix.</b> {{ n.n_hol }} weeks sell {{ "%.0f" | format(n.step * 100) }}% more or less than their type and have a template of their own there, starting with Thanksgiving, Christmas and New Year's; other holidays are noted on the type's page.</p></div>
      <div class="finding"><div class="num">05</div><p><b>Every week keeps its numbers, at today's level.</b> A week sells {{ "%.0f" | format(n.fit_lo * 100) }}–{{ "%.0f" | format(n.fit_hi * 100) }}% off its template on average (Weeks sheet). Today's run-rate, no growth ({{ n.total_rr | fm }}); {{ n.live.first.strftime("%b %-d") }}–{{ n.live.last.strftime("%-d") }} came in {{ n.live.sales | pct1 }} against it.</p></div>
    </div>
    <div class="col" style="flex:1">
      <h3>How to use it</h3>
      <ol class="steps" style="margin-top:8px">
        <li><span>Find the week in the calendar (pages 4–5, or the Calendar sheet): it gives the week's type. A dot marks a holiday week: its template is in the appendix.</span></li>
        <li><span>Check the week's own sales in the Weeks sheet: if a day runs a few percent above or below the template, scale that day.</span></li>
        <li><span>Open the café's page for that type: sales and checks for every hour, Monday to Sunday.</span></li>
        <li><span>Staff each hour to its sales and checks with your own productivity standard.</span></li>
        <li><span>On a holiday listed on the type's page, adjust that day: the page says how much more or less it sells.</span></li>
      </ol>
      <div class="box" style="margin-top:8px"><p><b>One page per café</b> shows its year week by week and its types; then one page per type. Holiday weeks are in the appendix. The workbook has every template, with formulas for the totals.</p></div>
    </div>
  </div>
  {{ foot(SRC) }}
</section>

{# ================================================================== METHOD #}
<section class="page method">
  {{ head("How the types and templates are made") }}
  <h1>Weeks from the run-rate, hours from Toast</h1>
  <div class="row" style="margin-top:12px">
    <div class="col">
      <h3>The types of week</h3>
      <p>Each café's next 52 weeks at today's run-rate (Monday to Sunday, from {{ n.w1.strftime("%b %-d, %Y") }}) are split into types in runs of at least {{ n.min_run }} weeks, the first and last included, so a type always runs from one week to another. The split keeps each week as close as it can to its type's level, and every change of type has to be worth about four weeks 5% off.</p>
      <p>A café gets as many types as it can, up to four, while each type sells at least {{ "%.0f" | format(n.step * 100) }}% more than the one below it; never fewer than two. Types are named by level: Low and High; Low, Normal and High; or Low, Normal, High and Super high.</p>
      <h3>Holiday weeks</h3>
      <p>Weeks with a holiday (and spring break) do not move the types. Where one sells {{ "%.0f" | format(n.step * 100) }}% more or less than its type's average week, it gets a template of its own, in the appendix; otherwise its holidays are listed on the type's page with what they sell.</p>
      <h3>La Jolla Cove</h3>
      <p>The run-rate carries the budget's remodeled café ($125K a month) from its October 1, 2027 reopening: its types are found on the weeks before, and the three weeks after are one more type, Remodeled. Its hours follow today's café until the remodeled one has its own.</p>
    </div>
    <div class="col">
      <h3>The template of a type</h3>
      <p>The average of the type's weeks, day by day (holiday weeks with their own template left out), so the templates on the calendar add up to the run-rate. Each day is split into hours along the café's pattern for that weekday (the hour each check was opened in Toast, {{ n.hours_from.strftime("%b %Y") }} to {{ n.last_day.strftime("%b %-d, %Y") }}, the last {{ n.half_life }} days weighing half), moved by the type's season: its own split of the day, measured within each year (so the drift to earlier hours each year is not read as a season) and used at half strength, as it changes from year to year. Holidays follow their own pattern from earlier years. Checks: each hour's sales over the café's average check for that hour and day, last {{ n.check_months }} months.</p>
      <h3>Tested on the last year</h3>
      <table class="compact" style="margin-top:4px;table-layout:fixed">
        <colgroup><col style="width:64%"><col style="width:18%"><col style="width:18%"></colgroup>
        <thead><tr><th class="l">Hourly error, splitting the actual day (|actual − split| ÷ actual)</th><th>Oct 2025 – Oct 2026</th><th>Apr – Oct 2026</th></tr></thead>
        <tbody>
          <tr><td>Weekday pattern × half the season's shift (used)</td><td><b>{{ "%.2f" | format(n.bt.half[0]) }}%</b></td><td><b>{{ "%.2f" | format(n.bt.half[1]) }}%</b></td></tr>
          <tr><td>Weekday pattern alone / with the full shift</td><td>{{ "%.2f" | format(n.bt.weekday[0]) }}% / {{ "%.2f" | format(n.bt.full[0]) }}%</td><td>{{ "%.2f" | format(n.bt.weekday[1]) }}% / {{ "%.2f" | format(n.bt.full[1]) }}%</td></tr>
          <tr><td>A pattern of its own per type and weekday</td><td>{{ "%.2f" | format(n.bt.type) }}%</td><td></td></tr>
          <tr><td>All days weighing the same (used: half-life {{ n.half_life }} days)</td><td></td><td>{{ "%.2f" | format(n.bt.hl_none) }}%</td></tr>
          <tr><td>Holidays: their own pattern (used) / the weekday's</td><td><b>{{ "%.1f" | format(n.bt.sp_own) }}%</b> / {{ "%.1f" | format(n.bt.sp_type) }}%</td><td></td></tr>
          <tr><td>Checks from the average check, last {{ n.check_months }} months</td><td></td><td>{{ "%.1f" | format(n.bt.chk) }}%</td></tr>
          <tr class="sep"><td><b>Live, {{ n.live.first.strftime("%b %-d") }}–{{ n.live.last.strftime("%-d") }}</b> (after the data): sales against the run-rate, ten cafés</td><td colspan="2"><b>{{ n.live.sales | pct1 }}</b></td></tr>
          <tr><td>Hourly error, the run-rate day on the pattern / checks against expected</td><td colspan="2"><b>{{ "%.1f" | format(n.live.hour_err * 100) }}%</b> / {{ n.live.checks | pct1 }}</td></tr>
        </tbody>
      </table>
      <p class="note" style="margin-top:6px">Learned before each period; mostly the noise of one hour on one day. Live by café: {{ n.live.lo.sales | pct1 }} ({{ n.live.lo.name }}) to {{ n.live.hi.sales | pct1 }} ({{ n.live.hi.name }}).</p>
    </div>
  </div>
  {{ foot("Code: weektypes/ (model, hourly patterns, backtests, templates) · " ~ SRC) }}
</section>

{# ================================================================== CALENDAR #}
<section class="page">
  {{ head("The next 52 weeks") }}
  <h1>Every week of the next 52 and its type, café by café</h1>
  <p class="lede">Week 1 starts Monday {{ n.w1.strftime("%b %-d, %Y") }}; week 52 ends Sunday {{ n.w52.strftime("%b %-d, %Y") }}. A dot marks a holiday week with a template of its own, in the appendix.</p>
  <table class="cal">
    <tr class="m"><th></th>{% for m in n.months %}<td>{{ m }}</td>{% endfor %}<td class="n"></td></tr>
    <tr class="w"><th></th>{% for x in n.week_heads %}<td>{{ x }}</td>{% endfor %}<td class="n" style="font-size:9px;font-weight:600">Types</td></tr>
    {% for r in n.calendar %}
    <tr><th>{{ r.name }}</th>{% for c in r.cells %}<td class="{{ 'own' if c.own }}{{ ' dk' if c.own and c.color in ['#82888a', '#373a3c'] }}" style="background:{{ c.color }}" title="{{ c.tip }}"></td>{% endfor %}<td class="n">{{ r.n }}{% if r.remodeled %}<sup style="font-size:9px">+1</sup>{% endif %}</td></tr>
    {% endfor %}
  </table>
  <div class="legend" style="margin-top:12px">
    {% for t in TYPES %}<span><i style="background:{{ n.COLOR[t] }}"></i>{{ t }}</span>{% endfor %}
    <span><i class="dot"></i>Holiday week with its own template (appendix)</span>
    <span class="note" style="margin-left:auto">+1: La Jolla Cove's remodeled café from October 1, 2027</span>
  </div>
  {{ foot(SRC) }}
</section>

{# ================================================================== TYPES AT A GLANCE #}
<section class="page">
  {{ head("The next 52 weeks") }}
  <h1>The types at a glance: their dates and average week</h1>
  <p class="lede">Dates run Monday to Sunday. Holiday weeks with their own template sit inside these dates; their templates are in the appendix.</p>
  <table class="sum" style="margin-top:6px">
    <thead><tr><th class="l">Café</th>{% for t in TYPES %}<th class="l">{{ badge(t) }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for st in n.stores %}{% set by = {} %}{% for ty in st.types %}{% set _ = by.update({ty.name: ty}) %}{% endfor %}
      <tr><td class="nw l"><b>{{ st.name }}</b></td>
      {% for t in TYPES %}{% set ty = by.get(t) %}
        <td class="l">{% if ty %}<b>{{ ty.avg | fk }}</b> a week<br>{{ ty.ranges | map(attribute="dates") | join("<br>") }}{% else %}<span class="dim">—</span>{% endif %}</td>
      {% endfor %}</tr>
    {% endfor %}
    </tbody>
  </table>
  {{ foot(SRC) }}
</section>

{# ================================================================== STORES #}
{% for st in n.stores %}
{% set sw = st.weeks %}
<section class="page">
  {{ head(st.name ~ " · week types, next 52 weeks") }}
  <div class="tag-row"><span class="name">{{ st.name }}</span>{% for ty in st.types %}{{ badge(ty.name) }}{% endfor %}</div>
  <h1>{{ st.name }}: {{ st.n_word }} types of week{% if st.cove %} and the remodeled café{% endif %}</h1>
  <p class="lede">A week sells on average {{ "%.1f" | format(st.fit_week * 100) }}% more or less than its template (at most {{ "%.0f" | format(st.far * 100) }}%).{% if st.small_step %} Two types is the minimum: here they are {{ "%.1f" | format(st.step * 100) }}% apart, under the {{ "%.0f" | format(n.step * 100) }}% rule, so the weeks change little through the year.{% endif %}</p>
  <div class="chart-title">Run-rate by week, {{ n.w1.strftime("%b %-d, %Y") }} to {{ n.w52.strftime("%b %-d, %Y") }}, coloured by type</div>
  <div class="chart-sub">Dashed lines: each type's average week{% if st.hols %} · outlined with a dot: holiday weeks with a template of their own (appendix){% endif %}</div>
  {{ st.svg }}
  <table class="types{{ ' tight' if (st.types | length) > 4 }}" style="margin-top:8px">
    <thead><tr><th class="l">Type</th><th class="l">Week numbers</th><th class="l">Dates</th><th>Weeks</th><th>Average week</th><th>Vs type below</th><th>Vs its template</th><th>Weekend vs weekday</th><th>Before 11am</th><th>11am–2pm</th><th>After 2pm</th></tr></thead>
    <tbody>
    {% for ty in st.types %}
      <tr><td>{{ badge(ty.name) }}</td><td class="l">{{ ty.ranges | map(attribute="weeks") | join(", ") }}</td><td class="l">{{ ty.ranges | map(attribute="dates") | join(", ") }}</td>
        <td>{{ ty.n_weeks }}</td><td><b>{{ ty.avg | money }}</b></td><td>{{ ty.vs_below | pct if ty.vs_below is not none else "—" }}</td>
        <td>±{{ "%.1f" | format(ty.fit_week * 100) }}%</td><td>{{ ty.weekend | pct }}</td>{% for x in ty.parts %}<td>{{ "%.1f" | format(x * 100) }}%</td>{% endfor %}</tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="types-note">{% if st.hols %}<b>Holiday weeks with a template of their own, in the appendix:</b> {% for h in st.hols %}{{ h.name }} ({{ h.dates }}, {{ h.vs | pct }} on a {{ h.type }} week){{ "; " if not loop.last else "." }}{% endfor %}{% else %}No holiday week sells {{ "%.0f" | format(n.step * 100) }}% more or less than its type: the holidays are noted on each type's page.{% endif %}</p>
  {{ foot("Hours shown: " ~ st.hours ~ " · " ~ SRC) }}
</section>

{% for ty in st.types %}
<section class="page">
  {{ head(st.name ~ " · week templates") }}
  <div class="tag-row">{{ badge(ty.name) }}<span class="name">{{ st.name }}</span></div>
  <h1>{{ ty.name }} weeks: {{ ty.avg | fk }} a week, {{ ty.ranges | map(attribute="dates") | join(" and ") }}</h1>
  <div class="row" style="gap:.3in;margin-top:6px">
    <div class="col" style="flex:3.6">{{ ty.heat }}
      {% if ty.cards %}<div class="hol-t"><b>Holidays in these weeks</b> · the day's sales against the same day of this template{% if ty.more_notes %} · {{ ty.more_notes }} more within ±{{ "%.0f" | format(ty.more_max * 100) }}% (Weeks sheet){% endif %}</div>
      <div class="hols">{% for x in ty.cards %}<div class="hc"><div class="hn"><b>{{ x.day }}</b></div><div class="hd">{{ x.dow }} {{ x.short }} · {{ x.sales | money }}</div><div class="hv"><span class="{{ 'up' if x.vs > 0 else 'dn' }}">{{ x.vs | pct }}</span> <small>vs {{ x.base | money }}</small></div></div>{% endfor %}</div>
      {% elif ty.more_notes %}<div class="hol-t"><b>Holidays in these weeks</b> · all within ±{{ "%.0f" | format(ty.more_max * 100) }}% of the same day of this template (Weeks sheet)</div>{% endif %}
    </div>
    <div class="col side" style="flex:1">
      <div class="blk"><div class="lab">Average week</div><div class="val">{{ ty.avg | money }}</div>
        <div class="cap">{% if ty.vs_below is not none %}{{ ty.vs_below | pct }} on a {{ ty.below }} week{% elif ty.name == "Remodeled" %}the remodeled café, from Oct 1, 2027{% else %}the café's lowest type{% endif %} · weeks from {{ ty.lo | fk }} to {{ ty.hi | fk }}</div></div>
      <div class="blk"><div class="lab">Checks a week</div><div class="val mid">{{ "{:,}".format(ty.checks) }}</div><div class="cap">average check ${{ "%.2f" | format(ty.avg_check) }}</div></div>
      <div class="blk"><div class="lab">Busiest hour</div><div class="val mid">{{ ty.peak }}</div><div class="cap">{{ ty.peak_sales | money }} · a weekend day sells {{ ty.weekend | pct }} on a weekday<br>Part of the week: {{ "%.0f" | format(ty.parts[0] * 100) }}% before 11am, {{ "%.0f" | format(ty.parts[1] * 100) }}% 11am–2pm, {{ "%.0f" | format(ty.parts[2] * 100) }}% after 2pm</div></div>
      <div class="blk"><div class="lab">Use it in {{ ty.n_weeks }} week{{ "s" if ty.n_weeks > 1 }}</div>
        <ul>{% for r in ty.ranges %}<li><b>{{ r.weeks }}</b> · {{ r.dates }}</li>{% endfor %}</ul>
        {% if ty.own %}<div class="cap" style="margin-top:4px">Except {{ ty.own | map(attribute="name") | join(", ") }}: in the appendix.</div>{% endif %}
      </div>
      <div class="blk"><div class="lab">Its weeks against this template</div>
        <div class="cap">Each dot is one week's own sales; {{ "%.0f" | format(ty.within5 * 100) }}% of them within ±5%{% if ty.own %} (holiday weeks: appendix){% endif %}</div>
        {{ ty.spread }}</div>
      {% if ty.name == "Remodeled" %}<div class="blk"><div class="cap">Hours and checks follow today's café until the remodeled one has its own.</div></div>{% endif %}
    </div>
  </div>
  {{ foot("Average of the type's weeks at the run-rate · each cell: sales and checks in that hour · " ~ SRC) }}
</section>
{% endfor %}

{% endfor %}

{# ================================================================== APPENDIX: HOLIDAY WEEKS #}
<section class="page divider">
  <div class="div-left">
    <div class="part">Appendix</div>
    <div class="div-title">Holiday weeks</div>
    <p class="div-sub">The {{ n.n_hol }} weeks that sell {{ "%.0f" | format(n.step * 100) }}% more or less than their type. Each has a template of its own: use it instead of the type's that week.</p>
    <ul class="div-list">
      {% for st in n.stores if st.hols %}<li><span>{{ st.hols | length }}</span>{{ st.name }}: {{ st.hols | map(attribute="short") | join(", ") }}</li>{% endfor %}
    </ul>
    <img class="bird" src="assets/parrot-map.png" alt="">
  </div>
  <div class="div-right"><img src="assets/split-order.jpg" alt=""></div>
</section>

<section class="page">
  {{ head("Appendix · holiday weeks") }}
  <h1>The holiday weeks in date order</h1>
  <p class="lede">Each replaces its type's template for that week. {{ n.no_hol_stores | and_join }} have none: their holidays are noted on each type's page.</p>
  <table class="compact idx">
    <thead><tr><th class="l">Dates</th><th class="l">Week</th><th class="l">Café</th><th class="l">Holiday week</th><th>Sales</th><th class="l">Instead of</th><th>Against that template</th><th>After 2pm</th></tr></thead>
    <tbody>
    {% for h in n.hol_all %}
      <tr><td class="l">{{ h.dates }}</td><td class="l">{{ h.week }}</td><td class="l"><b>{{ h.store }}</b></td><td class="l">{{ h.name }}</td><td><b>{{ h.total | money }}</b></td><td class="l">{{ badge(h.type) }}</td><td>{{ h.vs | pct }}</td><td>{{ "%.1f" | format(h.parts[2] * 100) }}%</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {{ foot(SRC) }}
</section>

{% for st in n.stores %}
{% for h in st.hols %}
<section class="page">
  {{ head("Appendix · holiday weeks · " ~ st.name) }}
  <div class="tag-row"><span class="tbadge hol">Holiday week</span><span class="name">{{ st.name }}</span></div>
  <h1>{{ h.name }}: {{ h.total | fk }}, {{ h.dates }} ({{ h.vs | pct }} on a {{ h.type }} week)</h1>
  <div class="row" style="gap:.3in;margin-top:6px">
    <div class="col" style="flex:3.6">{{ h.heat }}</div>
    <div class="col side" style="flex:1">
      <div class="blk"><div class="lab">This week</div><div class="val">{{ h.total | money }}</div><div class="cap">week {{ h.week }} · instead of the {{ badge(h.type) }} template ({{ h.base | money }})</div></div>
      <div class="blk"><div class="lab">Checks</div><div class="val mid">{{ "{:,}".format(h.checks) }}</div><div class="cap">average check ${{ "%.2f" | format(h.avg_check) }}</div></div>
      {% if h.days %}<div class="blk"><div class="lab">Its special days, against a {{ h.type }} day</div>
        <ul>{% for x in h.days %}<li><b>{{ x.day }}</b> <small>{{ x.date }}</small><br>{{ x.sales | money }} · {{ x.vs | pct }}</li>{% endfor %}</ul></div>{% endif %}
      <div class="blk"><div class="cap">The week's own run-rate, day by day; holidays split into hours along their own pattern from earlier years.</div></div>
    </div>
  </div>
  {{ foot("The week's own days at the run-rate · each cell: sales and checks in that hour · " ~ SRC) }}
</section>
{% endfor %}
{% endfor %}
</body>
</html>
