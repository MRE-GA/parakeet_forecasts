      <tr class="hl"><td><span class="key pink"></span>Plan</td>{% for r in n.months27 %}<td>{{ "{:,.0f}".format(r.plan / 1e3) }}</td>{% endfor %}<td>{{ P.f2027 | fm(2) }}</td></tr>
      <tr><td class="muted">2026 (Q4 estimate)</td>{% for r in n.months27 %}<td class="muted">{{ "{:,.0f}".format(r.ref2026 / 1e3) }}</td>{% endfor %}<td class="muted">{{ n.e2026 | fm(2) }}</td></tr>
      <tr><td class="muted">Plan vs 2026</td>{% for r in n.months27 %}<td class="muted">{{ (r.plan / r.ref2026 - 1) | pct }}</td>{% endfor %}<td class="muted">{{ P.growth | pct }}</td></tr>
