<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Parakeet Cafe · 2027 Sales Forecast</title>
<style>
@font-face{font-family:"Monarcha";src:url("assets/Monarcha-Bold.otf") format("opentype");font-weight:100 900}
@font-face{font-family:"Playfair Display";src:url("assets/PlayfairDisplay-400.woff2") format("woff2");font-weight:400;font-style:normal}
@font-face{font-family:"Playfair Display";src:url("assets/PlayfairDisplay-400i.woff2") format("woff2");font-weight:400;font-style:italic}
@font-face{font-family:"Playfair Display";src:url("assets/PlayfairDisplay-700.woff2") format("woff2");font-weight:700;font-style:normal}
@font-face{font-family:"Playfair Display";src:url("assets/PlayfairDisplay-900.woff2") format("woff2");font-weight:900;font-style:normal}
@font-face{font-family:"Josefin Sans";src:url("assets/JosefinSans-400.woff2") format("woff2");font-weight:400}
@font-face{font-family:"Josefin Sans";src:url("assets/JosefinSans-500.woff2") format("woff2");font-weight:500}
@font-face{font-family:"Josefin Sans";src:url("assets/JosefinSans-600.woff2") format("woff2");font-weight:600}
@font-face{font-family:"Josefin Sans";src:url("assets/JosefinSans-700.woff2") format("woff2");font-weight:700}

:root{
  --pink:#ef4b81;--ink:#000;--paper:#fff;
  --g900:#373a3c;--g700:#565a5c;--g500:#82888a;--g300:#ccc;--g250:#ddd;--g100:#eceeef;--g50:#f2f2f2;
  --soft:rgba(221,221,221,.6);
  --display:"Monarcha","Playfair Display",serif;
  --body:"Playfair Display",Georgia,serif;
  --sans:"Josefin Sans","Helvetica Neue",sans-serif;
}
@page{size:11in 8.5in;margin:0}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--paper);color:var(--ink)}
body{font-family:var(--body);font-size:12px;line-height:1.5;letter-spacing:.2px;
     -webkit-print-color-adjust:exact;print-color-adjust:exact}
.page{width:11in;height:8.5in;padding:.48in .6in .62in;position:relative;overflow:hidden;break-after:page;
      display:flex;flex-direction:column}
.page .pin-bottom{margin-top:auto}
table.roomy td{padding-top:7.5px;padding-bottom:7.5px}
.page:last-child{break-after:auto}
body{counter-reset:pg}
.page{counter-increment:pg}
.pn::after{content:counter(pg)}
svg{display:block;max-width:100%;height:auto;overflow:visible}

/* chrome */
.head{display:flex;align-items:center;justify-content:space-between;padding-bottom:9px;border-bottom:1px solid var(--ink)}
.head img{height:22px;display:block}
.eyebrow{font-family:var(--sans);font-weight:600;font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:var(--g700)}
.eyebrow::before{content:"";display:inline-block;width:18px;height:2px;background:var(--pink);vertical-align:middle;margin:-3px 8px 0 0}
h1{font-family:var(--display);font-weight:700;font-size:28px;line-height:1.12;letter-spacing:.6px;margin:18px 0 6px}
h2{font-family:var(--display);font-weight:700;font-size:17px;letter-spacing:.4px;margin:0 0 6px;line-height:1.2}
h3{font-family:var(--sans);font-weight:700;font-size:10px;letter-spacing:1.6px;text-transform:uppercase;margin:0 0 6px;color:var(--ink)}
.lede{font-size:13.5px;color:var(--g900);max-width:9.3in;margin:0 0 16px}
.foot{position:absolute;left:.6in;right:.6in;bottom:.26in;display:flex;justify-content:space-between;gap:18px;
      font-family:var(--sans);font-size:8.5px;letter-spacing:.4px;color:var(--g500);border-top:1px solid var(--soft);padding-top:6px}
.muted{color:var(--g700)}
.small{font-size:10.5px;line-height:1.45}
.note{font-family:var(--sans);font-size:9px;color:var(--g500);letter-spacing:.2px;line-height:1.4}
b,strong{font-weight:700}
.pink{color:var(--pink)}
.row{display:flex;gap:.35in}
.col{flex:1;min-width:0}
.rule-top{border-top:2px solid var(--ink);padding-top:9px}
.rule-pink{border-top-color:var(--pink)}
.callout{border-left:2px solid var(--pink);padding:2px 0 2px 14px}

/* numbers */
.hero{font-family:var(--sans);font-weight:600;font-size:78px;line-height:1;letter-spacing:-.5px;color:var(--pink);margin-top:8px}
.hero-cap{font-family:var(--sans);font-size:11px;letter-spacing:.4px;color:var(--g700);margin-top:8px}
.tiles{display:flex;gap:0;margin-top:18px;border-top:1px solid var(--ink)}
.tile{flex:1;padding:10px 12px 0 0}
.tile + .tile{padding-left:14px;border-left:1px solid var(--soft)}
.tile .lab{font-family:var(--sans);font-size:9.5px;letter-spacing:.3px;color:var(--g700)}
.tile .val{font-family:var(--sans);font-weight:600;font-size:22px;margin-top:4px;letter-spacing:-.2px}
.tile .delta{font-family:var(--sans);font-size:9.5px;color:var(--g700);margin-top:2px}

/* tables */
table{border-collapse:collapse;width:100%;font-family:var(--sans);font-size:10.5px;font-variant-numeric:tabular-nums}
th{font-weight:600;font-size:8.5px;letter-spacing:1.1px;text-transform:uppercase;color:var(--g700);text-align:right;padding:0 7px 6px;border-bottom:1px solid var(--ink);vertical-align:bottom}
td{padding:5px 7px;text-align:right;border-bottom:1px solid var(--soft);white-space:nowrap}
th:first-child,td:first-child{text-align:left;padding-left:0}
td.l,th.l{text-align:left}
tr.total td{font-weight:700;border-top:1px solid var(--ink);border-bottom:none}
tr.hl td{font-weight:700}
.key{display:inline-block;width:9px;height:9px;margin-right:7px;vertical-align:0}
.key.pink{background:var(--pink)}.key.ink{background:var(--ink)}.key.gray{background:var(--g500)}
.best{font-family:var(--sans);font-size:8px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--paper);background:var(--pink);padding:2px 5px 1px;margin-left:6px;vertical-align:1px}

/* findings */
.findings{display:grid;grid-template-columns:1fr 1fr;gap:20px .4in;margin-top:30px}
.finding{display:flex;gap:12px}
.finding .num{font-family:var(--sans);font-weight:700;font-size:22px;color:var(--pink);line-height:1;min-width:28px}
.finding p{margin:0;font-size:12.5px;line-height:1.55}
.strip{display:flex;align-items:center;gap:14px;background:var(--g50);padding:10px 16px;font-size:11px}
.strip .lab{font-family:var(--sans);font-weight:700;font-size:9px;letter-spacing:1.4px;text-transform:uppercase;white-space:nowrap}

/* model cards */
.cards{display:flex;gap:.3in;margin-top:10px}
.card{flex:1;border-top:2px solid var(--ink);padding-top:10px}
.card .tag{font-family:var(--sans);font-size:9px;letter-spacing:1.4px;text-transform:uppercase;color:var(--g700)}
.card .how{font-style:italic;font-size:13px;color:var(--g900);margin:4px 0 12px;min-height:58px}
.card dl{margin:0;font-size:11.5px;line-height:1.5}
.card dt{font-family:var(--sans);font-weight:700;font-size:8.5px;letter-spacing:1.3px;text-transform:uppercase;color:var(--ink);margin-top:8px}
.card dd{margin:2px 0 0}
.card .result{margin-top:12px;padding-top:8px;border-top:1px solid var(--soft);font-family:var(--sans);font-size:10px;color:var(--g700)}
.card .result b{font-size:17px;color:var(--ink);font-weight:600;margin-right:6px}
.rules{margin-top:20px;background:var(--g50);padding:14px 18px;display:flex;gap:.3in}
.rules > div{flex:1;font-size:11px;line-height:1.5}

/* cover */
.cover{padding:0;display:flex;flex-direction:row}
.cover-left{width:56%;padding:.75in .6in .6in .75in;position:relative;display:flex;flex-direction:column}
.cover-left .logo{width:2.35in;display:block}
.cover-left .eyebrow{margin-top:1.05in}
.cover-title{font-family:var(--display);font-weight:700;font-size:56px;line-height:1.02;letter-spacing:1px;margin:14px 0 16px}
.cover-sub{font-style:italic;font-size:17px;line-height:1.45;color:var(--g900);margin:0;max-width:4.6in}
.cover-meta{margin-top:auto;font-family:var(--sans);font-size:9.5px;letter-spacing:.4px;color:var(--g700);line-height:1.6;border-top:1px solid var(--ink);padding-top:10px;max-width:4.6in}
.cover-right{width:44%;height:100%}
.cover-right img{width:100%;height:100%;object-fit:cover;display:block}
.cover .bird{position:absolute;width:1.25in;right:.35in;top:.55in;opacity:.95}

.chart-title{font-family:var(--sans);font-weight:600;font-size:10px;letter-spacing:.3px;color:var(--ink);margin:0 0 6px}
.chart-sub{font-family:var(--sans);font-size:9px;color:var(--g500);margin:-3px 0 6px}
ul.tight{margin:6px 0 0;padding-left:16px}
ul.tight li{margin:0 0 5px}
.risk{border-top:2px solid var(--ink);padding-top:9px}
.risk p{margin:10px 0 0;font-size:12px;line-height:1.55}
.risk .big{font-family:var(--sans);font-weight:600;font-size:30px;line-height:1;margin-top:10px}
.risk .cap{font-family:var(--sans);font-size:9.5px;color:var(--g700);margin-top:5px;letter-spacing:.2px}
</style>
</head>
<body>
{% set P = n.plan %}

{# ======================================================================= COVER #}
<section class="page cover">
  <div class="cover-left">
    <img class="logo" src="assets/logo-bird.png" alt="Parakeet Cafe">
    <img class="bird" src="assets/parrot-map.png" alt="">
    <div class="eyebrow">Sales forecast · October 2026</div>
    <div class="cover-title">2027 Sales<br>Forecast</div>
    <p class="cover-sub">Prophet, SARIMA and Holt-Winters, {{ "tuned and " if n.tuning else "" }}tested head-to-head on four years of Toast sales from our eleven cafés.</p>
    <div class="cover-meta">
      Toast POS net sales via MCP Andersons · {{ "{:,}".format(n.store_days) }} café-days ·
      {{ n.first_day.strftime("%b %Y") }} – {{ n.last_day.strftime("%b %-d, %Y") }}<br>
      Prepared October 15, 2026
    </div>
  </div>
  <div class="cover-right"><img src="assets/hero-2.jpg" alt=""></div>
</section>

{# ======================================================================= SUMMARY #}
<section class="page">
  <div class="head"><img src="assets/logo-bird.png" alt="Parakeet Cafe"><span class="eyebrow">A bird's-eye view</span></div>
  {% if P %}<h1>2027 sales plan: {{ P.f2027 | fm }}, {{ P.growth | pct }} on 2026</h1>
  {% else %}<h1>2027 net sales: {{ n.f2027[ENSEMBLE] | fm }}, {{ n.g2027[ENSEMBLE] | pct }} on 2026</h1>{% endif %}
  {% if n.tuning %}
  <p class="lede">We forecast each café's sales with three time-series models, tuned their settings and features on 2025, confirmed the gains on January–September 2026, and recommend the blend of the three, the most accurate option in every round.</p>
  {% else %}
  <p class="lede">We forecast each café's sales with three time-series models, scored them in five back-tests, and recommend the average of the three, which was the most accurate on every measure.</p>
  {% endif %}
  <div class="row" style="margin-top:14px;align-items:flex-start">
    <div class="col" style="flex:1.05">
      {% if P %}
      <div class="hero">{{ P.f2027 | fm }}</div>
      <div class="hero-cap">2027 sales plan · best estimate {{ n.f2027[ENSEMBLE] | fm }} shaded {{ (P.factor - 1) | pct(1) }} because over-forecasting costs {{ P.over_cost }}× more · existing 11 cafés</div>
      <div class="tiles">
        <div class="tile"><div class="lab">2027 best estimate</div><div class="val">{{ n.f2027[ENSEMBLE] | fm }}</div><div class="delta">{{ n.g2027[ENSEMBLE] | pct }} · blend of 3 tuned models</div></div>
      {% else %}
      <div class="hero">{{ n.f2027[ENSEMBLE] | fm }}</div>
      <div class="hero-cap">2027 net sales forecast · blend of Prophet, SARIMA and Holt-Winters · existing 11 cafés</div>
      <div class="tiles">
        <div class="tile"><div class="lab">2025 actual</div><div class="val">{{ n.a2025 | fm }}</div><div class="delta">{{ (n.a2025 / n.a2024 - 1) | pct }} vs 2024</div></div>
      {% endif %}
        <div class="tile"><div class="lab">2026 estimate</div><div class="val">{{ n.e2026 | fm }}</div><div class="delta">{{ n.g2026 | pct }} vs 2025</div></div>
        <div class="tile"><div class="lab">2027 model range</div><div class="val">${{ (n.low / 1e6) | round(1) }}–{{ (n.high / 1e6) | round(1) }}M</div><div class="delta">{{ n.g2027[n.low_model] | pct }} to {{ n.g2027[n.high_model] | pct }}</div></div>
      </div>
    </div>
    <div class="col" style="flex:.95">
      <div class="chart-title">2027 forecast by model</div>
      <div class="chart-sub">Net sales, 11 cafés · % change vs 2026 estimate</div>
      {{ svg.dots }}
    </div>
  </div>
  <div class="findings">
    <div class="finding"><div class="num">01</div><p><b>The flock keeps growing.</b> 2026 is landing near {{ n.e2026 | fm }} ({{ n.g2026 | pct }}). Like-for-like sales are up {{ n.lfl[2].sales | pct }} this year on {{ n.lfl[2].checks | pct }} more checks: the growth is traffic, not price.</p></div>
    <div class="finding"><div class="num">02</div><p><b>The three models agree within a narrow band.</b> Prophet {{ n.f2027["Prophet"] | fm }}, SARIMA {{ n.f2027["SARIMA"] | fm }}, Holt-Winters {{ n.f2027["Holt-Winters"] | fm }}: all expect another year of double-digit growth ({{ n.g2027[n.low_model] | pct }} to {{ n.g2027[n.high_model] | pct }}){% if n.tuning %}, now within {{ (n.high - n.low) | fm }} of each other (was {{ n.tuning.baseline_spread | fm }} before tuning){% endif %}.</p></div>
    {% if n.tuning %}{% set T = n.tuning %}
    <div class="finding"><div class="num">03</div><p><b>Tuning sharpened the forecast.</b> After {{ T.n_prophet + T.n_sarima + T.n_hw }} settings were tried on 2025, the blend's error on the untouched Jan–Sep 2026 holdout fell from {{ T.blend_before.holdout_wape | pct(1, False) }} to {{ T.blend_after.holdout_wape | pct(1, False) }} per café-month and from {{ T.blend_before.holdout_brand_wape | pct(1, False) }} to {{ T.blend_after.holdout_brand_wape | pct(1, False) }} for the brand total.</p></div>
    {% else %}
    <div class="finding"><div class="num">03</div><p><b>The back-tests favor the blend.</b> {{ n.best_single }} was the best single model, a nose ahead of Prophet ({{ n.bt[2].wape | pct(1, False) }} vs {{ n.bt[0].wape | pct(1, False) }} café-month error). Averaging all three cut the brand's monthly error to {{ n.bt[3].mape | pct(1, False) }} and missed period totals by {{ n.bt[3].abs_err | pct(1, False) }} on average.</p></div>
    {% endif %}
    {% if P %}
    <div class="finding"><div class="num">04</div><p><b>Plan on {{ P.f2027 | fm }}, leaning low on purpose.</b> Over-forecasting is {{ P.over_cost }}× costlier, so the plan shades the best estimate by {{ (P.factor - 1) | pct(1) }}; in 2026 that would have cut the months where the plan beat actual sales from {{ P.chosen.over_blend | pct(0, False) }} to {{ P.chosen.over_plan | pct(0, False) }}. New cafés are not in the number.</p></div>
    {% else %}
    <div class="finding"><div class="num">04</div><p><b>Plan on {{ n.f2027[ENSEMBLE] | fm }}, with {{ n.low | fm }} ({{ n.low_model }}) as the conservative case.</b> New cafés (Manhattan Beach, Studio City, Enclave) are not in the number. Our last four openings each added {{ n.analogs | map(attribute="first12") | min | fm }}–{{ (n.analogs | map(attribute="first12") | max / 1e6) | round(1) }}M in their first year.</p></div>
    {% endif %}
  </div>
  <div class="strip pin-bottom"><span class="lab">Live check</span><span>October 1–14, 2026, after the data the models were trained on: Toast recorded {{ n.live.actual | fm(2) }}; the best estimate was {{ n.live[ENSEMBLE] | pct(1) }} off{% if P %} and the plan {{ n.live["Plan"] | pct(1) }}{% endif %} (Prophet {{ n.live["Prophet"] | pct(1) }}, SARIMA {{ n.live["SARIMA"] | pct(1) }}, Holt-Winters {{ n.live["Holt-Winters"] | pct(1) }}).</span></div>
  <div class="foot"><span>Parakeet Cafe · 2027 Sales Forecast</span><span>Net sales from Toast POS (after discounts; excludes tax, tips and gift-card sales) · data through Oct 14, 2026</span><span class="pn"></span></div>
</section>

{# ======================================================================= HISTORY #}
<section class="page">
  <div class="head"><img src="assets/logo-bird.png" alt="Parakeet Cafe"><span class="eyebrow">Where we stand</span></div>
  <h1>Four years of growth: first new cafés, now the same cafés</h1>
  <p class="lede">Sales stepped up as Newport, Beverly Hills, Brentwood and Carlsbad opened in 2023–24. No café has opened since March 2024, so nearly all of the gains in 2025 and 2026 came from the same eleven cafés selling more.</p>
  <div class="row">
    <div class="col" style="flex:1.75">
      <div class="chart-title">Monthly net sales, all cafés</div>
      <div class="chart-sub">Oct 2022 – Sep 2026 · pink dots mark café openings</div>
      {{ svg.history }}
    </div>
    <div class="col" style="flex:1">
      <div class="chart-title">Annual net sales</div>
      <div class="chart-sub">2026E = Jan–Sep actual + Q4 forecast · 2027F = blend</div>
      {{ svg.annual }}
    </div>
  </div>
  <div class="row" style="margin-top:16px">
    <div class="col" style="flex:1.75">
      <h3>Like-for-like growth: same cafés, same months</h3>
      <table>
        <thead><tr><th class="l">Period</th><th>Cafés</th><th>Net sales</th><th>Checks (traffic)</th><th>Avg. check</th><th>Avg. check ($)</th></tr></thead>
        <tbody>
        {% for r in n.lfl %}
          <tr><td>{{ r.period }}</td><td>{{ r.cafes }}</td><td><b>{{ r.sales | pct(1) }}</b></td><td>{{ r.checks | pct(1) }}</td><td>{{ r.ticket | pct(1) }}</td><td>${{ "%.2f" | format(r.avg_ticket) }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="col callout small" style="flex:1;align-self:center">
      <b>The mix of growth has shifted.</b> In 2024 it was all price (+10% average check, flat traffic). In 2026 it is almost all traffic ({{ n.lfl[2].checks | pct }} checks, {{ n.lfl[2].ticket | pct }} average check). Busier cafés are a sturdier base for 2027 than price alone.
    </div>
  </div>
  <div class="foot"><span>Parakeet Cafe · 2027 Sales Forecast</span><span>Like-for-like = cafés trading the full Jan–Sep period in both years · checks = Toast checks</span><span class="pn"></span></div>
</section>

{# ======================================================================= MODELS #}
<section class="page">
  <div class="head"><img src="assets/logo-bird.png" alt="Parakeet Cafe"><span class="eyebrow">The models</span></div>
  <h1>Three ways to read the same history</h1>
  <p class="lede">Each model is fitted to every café separately and the eleven forecasts are added up, so a new opening is never mistaken for organic growth. The models differ mainly in how they extend the trend.</p>
  <div class="cards">
    <div class="card rule-pink">
      <div class="tag">Requested model · Meta</div>
      <h2>Prophet</h2>
      <div class="how">Splits daily sales into a trend, a weekly rhythm, a yearly season and holiday effects, then extends each one.</div>
      <dl>
        <dt>Sees</dt><dd>Daily sales per café, so weekends and holidays are learned directly (Mother's Day {{ n.holiday["Mother's Day"] | pct }}, Memorial Day {{ n.holiday["Memorial Day"] | pct }}, Christmas Eve {{ n.holiday["Christmas Eve"] | pct }}).</dd>
        <dt>Assumes about growth</dt><dd>The recent trend continues in a straight line, adding similar dollars each year.</dd>
        <dt>Watch-out</dt><dd>Ran about {{ n.bt[0].bias | pct(0, False) }} hot on average in the round-1 back-tests{% if n.high_model == "Prophet" %}; the highest 2027 forecast{% elif n.low_model == "Prophet" %}; the lowest 2027 forecast{% endif %}.</dd>
        <dt>Round-1 back-test</dt><dd>{{ n.bt[0].wape | pct(1, False) }} café-month error · {{ n.bt[0].mape | pct(1, False) }} brand monthly error</dd>{% if n.tuning %}{% set r = n.tuning.models[0] %}<dt>2026 holdout, settings used</dt><dd>{{ (r.tuned_wape if r.adopted else r.baseline_wape) | pct(1, False) }} café-month error · {{ (r.tuned_brand_wape if r.adopted else r.baseline_brand_wape) | pct(1, False) }} brand error{{ " (tuned)" if r.adopted else " (round-1 settings kept)" }}</dd>{% endif %}
      </dl>
      <div class="result"><b>{{ n.f2027["Prophet"] | fm }}</b>2027 · {{ n.g2027["Prophet"] | pct }}</div>
    </div>
    <div class="card">
      <div class="tag">Classic statistics · Box–Jenkins</div>
      <h2>SARIMA</h2>
      <div class="how">{% if n.tuning and n.tuning.adopted.models["SARIMA"].trend == "local" %}Seasonal ARIMA: next year looks like last year, adjusted by the recent trend in the café's year-on-year changes.{% else %}Seasonal ARIMA: next year looks like last year, scaled by the café's average year-on-year growth.{% endif %}</div>
      <dl>
        <dt>Sees</dt><dd>Monthly sales per café, adjusted for how many Saturdays, Sundays and closed days each month has.</dd>
        <dt>Assumes about growth</dt><dd>{% set st = n.tuning.adopted.models["SARIMA"].trend if n.tuning else "drift" %}{% if st == "drift" %}The café's average year-on-year growth rate carries on, compounding.{% elif st == "local" %}Growth follows the café's recent year-on-year trend, re-estimated as each month lands, rather than its long-run average.{% else %}No growth term: next year repeats this year's level, plus short-term momentum.{% endif %}</dd>
        <dt>Watch-out</dt><dd>The least precise café by café in round 1{% if n.high_model == "SARIMA" %}; the highest 2027 forecast{% elif n.low_model == "SARIMA" %}; the lowest 2027 forecast{% endif %}.</dd>
        <dt>Round-1 back-test</dt><dd>{{ n.bt[1].wape | pct(1, False) }} café-month error · {{ n.bt[1].mape | pct(1, False) }} brand monthly error</dd>{% if n.tuning %}{% set r = n.tuning.models[1] %}<dt>2026 holdout, settings used</dt><dd>{{ (r.tuned_wape if r.adopted else r.baseline_wape) | pct(1, False) }} café-month error · {{ (r.tuned_brand_wape if r.adopted else r.baseline_brand_wape) | pct(1, False) }} brand error{{ " (tuned)" if r.adopted else " (round-1 settings kept)" }}</dd>{% endif %}
      </dl>
      <div class="result"><b>{{ n.f2027["SARIMA"] | fm }}</b>2027 · {{ n.g2027["SARIMA"] | pct }}</div>
    </div>
    <div class="card">
      <div class="tag">Classic statistics · exponential smoothing</div>
      <h2>Holt-Winters</h2>
      <div class="how">Tracks a level, a trend and a seasonal pattern, giving the latest months the most weight.</div>
      <dl>
        <dt>Sees</dt><dd>The same trading-day-adjusted monthly sales as SARIMA.</dd>
        <dt>Assumes about growth</dt><dd>{% set hw = n.tuning.adopted.models["Holt-Winters"] if n.tuning else {"trend": "add", "damped": true, "phi": none} %}{% if not hw.trend %}No trend: next year repeats the latest level and seasonal pattern.{% elif not hw.damped %}A straight-line trend: the recent monthly gain continues.{% elif hw.phi %}A damped trend (φ = {{ hw.phi }}): growth continues but fades over the following months.{% else %}A damped trend: growth continues but gradually flattens out.{% endif %}</dd>
        <dt>Watch-out</dt><dd>Under-forecast in four of five round-1 back-tests{% if n.low_model == "Holt-Winters" %}; the lowest 2027 forecast{% elif n.high_model == "Holt-Winters" %}; the highest 2027 forecast{% endif %}.</dd>
        <dt>Round-1 back-test</dt><dd>{{ n.bt[2].wape | pct(1, False) }} café-month error · {{ n.bt[2].mape | pct(1, False) }} brand monthly error</dd>{% if n.tuning %}{% set r = n.tuning.models[2] %}<dt>2026 holdout, settings used</dt><dd>{{ (r.tuned_wape if r.adopted else r.baseline_wape) | pct(1, False) }} café-month error · {{ (r.tuned_brand_wape if r.adopted else r.baseline_brand_wape) | pct(1, False) }} brand error{{ " (tuned)" if r.adopted else " (round-1 settings kept)" }}</dd>{% endif %}
      </dl>
      <div class="result"><b>{{ n.f2027["Holt-Winters"] | fm }}</b>2027 · {{ n.g2027["Holt-Winters"] | pct }}</div>
    </div>
  </div>
  <div class="rules" style="margin-top:26px">
    <div><h3>Same data</h3>Toast net sales for 11 cafés, {{ n.first_day.strftime("%b %Y") }} to Sep 2026; models fitted on data through Sep 30, 2026.</div>
    <div><h3>Same clean-up</h3>One-off disruptions are removed from training (Tropical Storm Hilary, Aug 2023; the LA fires at Brentwood, Jan 2025; closure days) but still count as actual sales in every test.</div>
    <div><h3>Same scoring</h3>Every model faces the same five back-tests and is judged against real Toast sales.</div>
  </div>
  <div class="foot"><span>Parakeet Cafe · 2027 Sales Forecast</span><span>Technical settings for each model are in the appendix</span><span class="pn"></span></div>
</section>

{# ======================================================================= BACKTEST #}
<section class="page">
  <div class="head"><img src="assets/logo-bird.png" alt="Parakeet Cafe"><span class="eyebrow">Back-testing</span></div>
  <h1>Five dress rehearsals: which model would have called it?</h1>
  <p class="lede">We rewound the clock five times (Sep 2024, Dec 2024, Mar 2025, Jun 2025, Sep 2025). Each time, every model saw only the data known on that date and forecast months 4 to 15 ahead, the same gap that separates today from 2027. That gave {{ n.bt_store_months }} café-months to score against what Toast actually recorded.</p>
  {{ svg.accuracy }}
  <div class="row" style="margin-top:14px">
    <div class="col" style="flex:1.6">
      <table>
        <thead><tr><th class="l">Model</th><th>Café-month error<br>(WAPE)</th><th>Brand monthly error<br>(MAPE)</th><th>Avg. miss on<br>period total</th><th>Worst miss on<br>period total</th><th>Average bias</th></tr></thead>
        <tbody>
        {% for r in n.bt %}
          <tr class="{{ 'hl' if r.key == ENSEMBLE else '' }}"><td><span class="key {{ 'pink' if r.key == ENSEMBLE else 'gray' }}"></span>{{ r.model }}{% if r.key == ENSEMBLE %}<span class="best">Best</span>{% endif %}</td>
            <td>{{ r.wape | pct(1, False) }}</td><td>{{ r.mape | pct(1, False) }}</td><td>{{ r.abs_err | pct(1, False) }}</td><td>{{ r.max_err | pct(1, False) }}</td><td>{{ r.bias | pct(1) }} {{ 'over' if r.bias > 0 else 'under' }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      <p class="note" style="margin-top:6px">Lower is better. WAPE = total absolute error ÷ total sales, over all café-months. MAPE = average % error of the 11-café monthly total. Period total = the 12 months each rehearsal covered (9 for the last one).</p>
    </div>
    <div class="col callout small" style="flex:1">
      <b>Verdict.</b> {{ n.best_single }} is the most accurate single model month to month, a nose ahead of Prophet; the two are effectively tied café by café. SARIMA is the best of the three on period totals but the least precise café by café. Prophet tends to run a little hot and Holt-Winters a little cold, so their errors partly cancel. <b>The blend beat every single model on every measure</b>, and its worst miss on a period total was {{ n.bt[3].max_err | pct(1, False) }}.
    </div>
  </div>
  <div class="foot"><span>Parakeet Cafe · 2027 Sales Forecast</span><span>Cafés enter a rehearsal once they have 24 full months of history (5 cafés in Sep 2024, 7 from Dec 2024, 9 in Sep 2025)</span><span class="pn"></span></div>
</section>

{# ======================================================================= REHEARSALS #}
<section class="page">
  <div class="head"><img src="assets/logo-bird.png" alt="Parakeet Cafe"><span class="eyebrow">Back-testing</span></div>
  <h1>The rehearsals up close</h1>
  <p class="lede">Rehearsals 1 and 5 bracket the test: the oldest forecast, made with two years of history, and the newest. The shaded band is the spread between the three models; the pink line is their average.</p>
  <div class="row">
    <div class="col">{{ svg.rehearsal[0] }}</div>
    <div class="col">{{ svg.rehearsal[1] }}</div>
  </div>
  <div class="row" style="margin-top:12px">
    <div class="col">
      <h3>Miss on the period total, by rehearsal</h3>
      <table>
        <thead><tr><th class="l">Rehearsal (data through)</th><th>Cafés</th><th>Months</th>{% for m in MODELS %}<th>{{ m }}</th>{% endfor %}<th>Blend</th></tr></thead>
        <tbody>
        {% for origin, r in n.bt_folds.iterrows() %}
          <tr><td>{{ loop.index }} · {{ n.fold_label[origin] }}</td><td>{{ n.bt_fold_meta.loc[origin, "stores"] }}</td><td>{{ n.bt_fold_meta.loc[origin, "months"] }}</td>
          {% for m in MODELS %}<td>{{ r[m] | pct(1) }}</td>{% endfor %}<td><b>{{ r[ENSEMBLE] | pct(1) }}</b></td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="col callout small" style="flex:.62;align-self:center">
      <b>Live check, October 1–14, 2026.</b> These two weeks came after the data the final models were trained on. Toast recorded {{ n.live.actual | fm(2) }}; the blend forecast was {{ n.live[ENSEMBLE] | pct(1) }} off (Prophet {{ n.live["Prophet"] | pct(1) }}, SARIMA {{ n.live["SARIMA"] | pct(1) }}, Holt-Winters {{ n.live["Holt-Winters"] | pct(1) }}).
    </div>
  </div>
  <div class="foot"><span>Parakeet Cafe · 2027 Sales Forecast</span><span>Positive = over-forecast · October check prorates each model's October forecast by trading days</span><span class="pn"></span></div>
</section>

{% if n.tuning %}{% set T = n.tuning %}
{# ======================================================================= TUNING #}
<section class="page">
  <div class="head"><img src="assets/logo-bird.png" alt="Parakeet Cafe"><span class="eyebrow">Round 2 · Tuning</span></div>
  <h1>Tuned on 2025, proven on 2026</h1>
  <p class="lede">Each model searched for better settings and features using only its forecasts of 2025: {{ T.n_prophet }} Prophet trials (Optuna) and every one of {{ T.n_sarima }} SARIMA and {{ T.n_hw }} Holt-Winters combinations. The winners then faced a holdout the search never saw: forecasts made in June, September and December 2025 for January to September 2026 ({{ T.holdout_store_months }} café-months).</p>
  {{ svg.dumbbells }}
  <div class="row" style="margin-top:12px">
    <div class="col" style="flex:1.7">
      <table>
        <thead><tr><th class="l">Model</th><th>Café-month error<br>round 1 → tuned</th><th>Brand monthly error<br>round 1 → tuned</th><th>Miss on period total<br>round 1 → tuned</th><th class="l" style="padding-left:14px">Decision</th></tr></thead>
        <tbody>
        {% for r in T.models %}
          <tr><td>{{ r.model }}</td>
            <td>{{ r.baseline_wape | pct(1, False) }} → <b>{{ r.tuned_wape | pct(1, False) }}</b></td>
            <td>{{ r.baseline_brand_wape | pct(1, False) }} → <b>{{ r.tuned_brand_wape | pct(1, False) }}</b></td>
            <td>{{ r.baseline_window_abs_error | pct(1, False) }} → <b>{{ r.tuned_window_abs_error | pct(1, False) }}</b></td>
            <td class="l" style="padding-left:14px">{{ "Adopt tuned settings" if r.adopted else "Keep round-1 settings" }}</td></tr>
        {% endfor %}
          <tr class="hl"><td><span class="key pink"></span>Blend</td>
            <td>{{ T.blend_before.holdout_wape | pct(1, False) }} → {{ T.blend_after.holdout_wape | pct(1, False) }}</td>
            <td>{{ T.blend_before.holdout_brand_wape | pct(1, False) }} → {{ T.blend_after.holdout_brand_wape | pct(1, False) }}</td>
            <td>{{ T.blend_before.holdout_window_abs_error | pct(1, False) }} → {{ T.blend_after.holdout_window_abs_error | pct(1, False) }}</td>
            <td class="l" style="padding-left:14px">{{ "Simple average" if T.blend_rule == "mean" else T.blend_rule | capitalize }}</td></tr>
        </tbody>
      </table>
      <p class="note" style="margin-top:6px">Holdout: Jan–Sep 2026 sales, never used to choose settings. A tuned model is adopted only if it lowers the holdout score (average of café-month and brand-month error).</p>
    </div>
    <div class="col callout small" style="flex:1;align-self:center">{{ T.verdict }}</div>
  </div>
  <div class="foot"><span>Parakeet Cafe · 2027 Sales Forecast</span><span>Tuning set: forecasts made Sep 2024 – Jun 2025, scored on 2025 months · {{ T.tune_store_months }} café-months</span><span class="pn"></span></div>
</section>

{# ======================================================================= FEATURES #}
<section class="page">
  <div class="head"><img src="assets/logo-bird.png" alt="Parakeet Cafe"><span class="eyebrow">Round 2 · Features</span></div>
  <h1>Which features earned their place</h1>
  <p class="lede">{{ T.features_lede }}</p>
  <div class="row">
    <div class="col" style="flex:1.55">
      <table>
        <thead><tr><th class="l">Model</th><th class="l">Feature</th><th>Effect on<br>2025 score</th><th>Effect on<br>2026 holdout</th><th class="l" style="padding-left:14px">Verdict</th></tr></thead>
        <tbody>
        {% for f in T.features %}
          <tr><td>{{ f.model }}</td><td class="l" style="white-space:normal">{{ f.feature }}{% if f.in_best %} <span class="muted">· used</span>{% endif %}</td><td>{{ f.d_tune | pct(0) }}</td><td>{{ f.d_hold | pct(0) }}</td>
            <td class="l" style="padding-left:14px">{% if f.verdict == "helps" %}<b>Helps</b>{% elif f.verdict == "hurts" %}Hurts{% elif f.verdict == "no difference" %}<span class="muted">No difference</span>{% else %}<span class="muted">Mixed</span>{% endif %}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      <p class="note" style="margin-top:6px">Each feature switched on vs off with every other setting at the model's best; effect = change in score (average of café-month and brand-month error) when it is on, so negative is better. "Helps" or "Hurts" only when 2025 and 2026 agree; "No difference" when both move less than 1%. Weather could not be tested: this environment's network policy blocks the weather archive.</p>
    </div>
    <div class="col">
      <h3>How much growth to extrapolate?</h3>
      <table>
        <thead><tr><th class="l">Trend setting</th><th>Best score</th></tr></thead>
        <tbody>
        {% for k, v in T.sarima_trends.items() %}<tr><td>SARIMA · {{ k }}</td><td>{{ v | pct(2, False) }}</td></tr>{% endfor %}
        {% for k, v in T.hw_trends.items() %}<tr><td>Holt-Winters · {{ k }}</td><td>{{ v | pct(2, False) }}</td></tr>{% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  <div class="foot"><span>Parakeet Cafe · 2027 Sales Forecast</span><span>Every trial and grid result: outputs/tuning/</span><span class="pn"></span></div>
</section>

{# ======================================================================= TOP-DOWN #}
<section class="page">
  <div class="head"><img src="assets/logo-bird.png" alt="Parakeet Cafe"><span class="eyebrow">Round 2 · Structure</span></div>
  <h1>One model per café, or one model for all?</h1>
  <p class="lede">{{ T.topdown_lede }}</p>
  <table style="margin-top:6px">
    <thead><tr><th class="l">Model (tuned settings)</th><th>Brand monthly error<br>per café</th><th>Brand monthly error<br>one model</th><th>Miss on period total<br>per café</th><th>Miss on period total<br>one model</th><th>2027 forecast<br>per café</th><th>2027 forecast<br>one model</th></tr></thead>
    <tbody>
    {% for r in T.topdown_rows %}
      <tr><td>{{ r.model }}</td><td>{{ r.per_cafe_mape | pct(1, False) }}</td><td>{{ r.total_mape | pct(1, False) }}</td><td>{{ r.per_cafe_miss | pct(1, False) }}</td><td>{{ r.total_miss | pct(1, False) }}</td><td>{{ r.per_cafe_2027 | fm(2) }}</td><td>{{ r.total_2027 | fm(2) }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="note" style="margin-top:6px">Holdout Jan–Sep 2026. "One model" is fitted to the combined sales of the cafés in each test; for 2027 it only has history from April 2024, when the eleventh café opened.</p>
  <div class="row" style="margin-top:18px;align-items:center">
    <div class="col">
      <div class="chart-title">Brand monthly error on the 2026 holdout</div>
      <div class="chart-sub">Lower is better · tuned settings</div>
      {{ svg.topdown }}
    </div>
    <div class="col callout small">{{ T.topdown_verdict }}</div>
  </div>
  <div class="foot"><span>Parakeet Cafe · 2027 Sales Forecast</span><span>Brand monthly error = MAPE of the combined monthly sales of the cafés in each test</span><span class="pn"></span></div>
</section>
{% endif %}

{% if P %}
{# ======================================================================= PLAN #}
<section class="page">
  <div class="head"><img src="assets/logo-bird.png" alt="Parakeet Cafe"><span class="eyebrow">The plan</span></div>
  <h1>Leaning low on purpose</h1>
  <p class="lede">Over-forecasting sales costs more than under-forecasting: labor, purchasing and targets get set too high. So the plan sits below the best estimate. The models were not weakened to get there; they are still tuned only for accuracy. Instead we measured how the blend has actually missed, and set the plan where the expected cost is lowest when an over-forecast dollar costs {{ P.over_cost }} under-forecast dollars.</p>
  <div class="row">
    <div class="col" style="flex:1.5">
      <table>
        <thead><tr><th class="l">If over-forecasting costs</th><th>Shade the<br>best estimate</th><th>2027<br>plan</th><th>2026 months above actual<br>best estimate → plan</th><th>2026 cost<br>best estimate → plan</th></tr></thead>
        <tbody>
        {% for r in P.rows %}
          <tr class="{{ 'hl' if r.chosen else '' }}"><td>{{ r.over_cost }}× under-forecasting{% if r.chosen %}<span class="best">Plan</span>{% endif %}</td><td>{{ (r.factor - 1) | pct(1) }}</td><td>{{ r.f2027 | fm(2) }}</td><td>{{ r.over_blend | pct(0, False) }} → {{ r.over_plan | pct(0, False) }}</td><td>{{ r.cost_blend | pct(1, False) }} → {{ r.cost_plan | pct(1, False) }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      <p class="note" style="margin-top:6px">Shade = the multiplier that minimises the asymmetric cost of monthly brand misses on forecasts made 4–15 months ahead (2025 and 2026 targets). The 2026 columns test the multiplier fitted on 2025 alone against Jan–Sep 2026 ({{ P.holdout_months }} brand-months). Cost = over-forecast dollars × ratio + under-forecast dollars, as a share of sales.</p>
    </div>
    <div class="col">
      <div class="chart-title">2027 plan by cost of over-forecasting</div>
      <div class="chart-sub">Net sales, 11 cafés · % vs 2026 estimate</div>
      {{ svg.plan_ladder }}
    </div>
  </div>
  <div class="row" style="margin-top:14px;align-items:center">
    <div class="col" style="flex:1.1">
      <div class="chart-title">How the plan would have tracked 2026</div>
      <div class="chart-sub">Plan = best estimate × the {{ P.over_cost }}:1 shade fitted on 2025 only</div>
      {{ svg.plan_backtest }}
    </div>
    <div class="col callout small">{{ P.narrative }}</div>
  </div>
  <div class="foot"><span>Parakeet Cafe · 2027 Sales Forecast</span><span>outputs/tuning/plan_calibration.csv · plan factor in outputs/tuned_configs.json</span><span class="pn"></span></div>
</section>
{% endif %}

