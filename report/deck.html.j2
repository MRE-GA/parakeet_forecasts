      </ul>
    </div>
  </div>
  {{ foot(SRC) }}
</section>

{# ================================================================== 13 WHAT WE SUGGEST #}
{% set S = n.suggest %}
<section class="page">
  {{ head("Part 2 · 2027") }}
  <h1>What we suggest: {{ S.total | fm }} for 2027, {{ S.total_change | sfm }} above the budget</h1>
