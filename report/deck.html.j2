  <div class="row">
    <div class="col" style="flex:1.35">
      <h3>New cafés: budget against our last four openings</h3>
      <table>
        <thead><tr><th class="l">Opening</th><th>First 8<br>months</th><th>First 10<br>months</th><th>First 12<br>months</th></tr></thead>
        <tbody>
        {% for a in O.analogs %}
          <tr><td>{{ a.store }} <span class="dim">({{ a.opened.strftime("%b %Y") }})</span></td><td>{{ a[8] | fm }}</td><td>{{ a[10] | fm }}</td><td>{{ a[12] | fm }}</td></tr>
        {% endfor %}
          <tr class="total"><td>Average opening</td><td>{{ O.avg[8] | fm }}</td><td>{{ O.avg[10] | fm }}</td><td>{{ O.avg[12] | fm }}</td></tr>
        {% for x in O.new %}
          <tr class="{{ 'sep' if loop.first else '' }}"><td class="pink">Budget: {{ x.name }} <span class="dim">(opens {{ x.opens.strftime("%b %-d") }}, {{ x.months }} months)</span></td>
            <td>{{ (x.budget | fm) if x.months == 8 else "" }}</td><td>{{ (x.budget | fm) if x.months == 10 else "" }}</td><td class="dim">{{ x.first12 | replace(" first 12 months", "") }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% set nb = n.bridge27.new_budget %}{% set best = O.new | sum(attribute="best") %}{% set la = O.new | sum(attribute="la") %}
      <h3 style="margin-top:16px">Both openings in 2027</h3>
      <div class="ledger compact">
        <div class="r"><div class="what">Budget</div><div><div class="bar base" style="width:{{ nb / best * 100 }}%"></div></div><div class="amt">{{ nb | fm }}</div></div>
        <div class="r"><div class="what">If both open like {{ O.best_name }}, our best</div><div><div class="bar" style="width:100%"></div></div><div class="amt">{{ best | fm }}</div></div>
        <div class="r"><div class="what">If both open like our average opening</div><div><div class="bar ours" style="width:{{ n.bridge27.new_track / best * 100 }}%"></div></div><div class="amt pink">{{ n.bridge27.new_track | fm }}</div></div>
        <div class="r"><div class="what">If both open like our LA openings</div><div><div class="bar" style="width:{{ la / best * 100 }}%"></div></div><div class="amt">{{ la | fm }}</div></div>
      </div>
